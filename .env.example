# Discord
DISCORD_TOKEN=
DISCORD_APP_ID=

# GameAP panel
GAMEAP_API_URL=http://127.0.0.1:8025
GAMEAP_TOKEN=

# Bot behavior
POLL_INTERVAL_MS=20000
LOG_LEVEL=info
# Idioma por defecto para los guilds que no fijan el suyo (config o /language).
# Valores: en, es-MX. Vacío = en.
DEFAULT_LOCALE=en
# safe mode for the idle auto-shutdown: logs and announces what it would do, without calling the panel
AUTOSTOP_DRY_RUN=false

# Paths (inside the container these are /app/...)
SERVERS_FILE=./config/servers.json
GUILDS_FILE=./config/guilds.json
STATE_FILE=./data/state.json
FEEDS_STATE_FILE=./data/feeds.json
